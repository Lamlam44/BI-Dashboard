# BI Dashboard Environment Configuration
# Copy this file to .env.local and update with your values

# ── CLOUD Setup (TiDB Cloud + Render + Vercel) ──────────────────
# Database Configuration (TiDB Cloud Serverless)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=3FhVda33nHpaura.root
DB_PASSWORD=your_tidb_password_here
DB_NAME=retails_dataset
SSL_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# API Server (Render)
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=https://bi-dashboard-3nmr.onrender.com

# Frontend (Vercel)
NEXT_PUBLIC_ANALYTICS_ID=

# ── LOCAL Setup (Comment above, uncomment below for local development) ──────
# Database Configuration (Local MySQL)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=12345
# DB_NAME=retails_dataset
# SSL_CA_PATH=

# API Server (Local)
# API_HOST=0.0.0.0
# API_PORT=8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Feature Flags
NEXT_PUBLIC_ENABLE_CHARTS=true
NEXT_PUBLIC_ENABLE_EXPORTS=false
NEXT_PUBLIC_ENABLE_REAL_TIME_DATA=false

# Invoice Ingest API Key
INGEST_API_KEY=bi-dashboard-ingest-key-2026

# Cache Configuration
CACHE_TTL=600
ANALYTICS_CACHE_TTL=900
